# === Cartera JDN — variables de entorno ===
# Copiar a .env.local y completar con los valores reales del proyecto Supabase.
# NUNCA commitear .env.local ni valores reales.

# URL del proyecto Supabase (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave anónima / pública (Project Settings → API → anon public).
# Es segura para el cliente; el acceso se controla por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# URL pública de la app (usada para links de confirmación/recuperación de auth).
# Ej. en local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service role key — SOLO servidor / scripts de migración. NUNCA exponer al cliente.
# Bypassa RLS. Requerida por `npm run migrate:prototype`.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# (Opcional) Ruta al HTML del prototipo para la migración de datos.
# Default: ~/Downloads/cartera_jdn-5.html
# PROTOTYPE_HTML=/ruta/a/cartera_jdn-5.html
