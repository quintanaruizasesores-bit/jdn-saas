# === Cartera JDN — variables de entorno ===
# Copiar a .env.local y completar con los valores reales del proyecto Supabase.
# NUNCA commitear .env.local ni valores reales.

# URL del proyecto Supabase (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave anónima / pública (Project Settings → API → anon public).
# Es segura para el cliente; el acceso se controla por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# URL pública de la app (usada para links de confirmación/recuperación de auth).
# Ej. en local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service role key — SOLO servidor / scripts de migración. NUNCA exponer al cliente.
# Bypassa RLS. Requerida por `npm run migrate:prototype`.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Exportación integral: UUIDs de administradores habilitados, separados por coma.
# Solo servidor. Vacío deshabilita todas las descargas integrales.
# También se exige role=ADMIN y la migración 009. Nunca NEXT_PUBLIC_*.
BACKUP_ADMIN_USER_IDS=

# (Opcional) Ruta al HTML del prototipo para la migración de datos.
# Default: ~/Downloads/cartera_jdn-5.html
# PROTOTYPE_HTML=/ruta/a/cartera_jdn-5.html

# === Recordatorios por email (Resend) — SOLO servidor ===
# Se configura UNA vez para toda la aplicación; cada usuario solo elige su
# correo de destino y preferencias en Configuración → Notificaciones por email.
# Nunca exponer estas variables al cliente (no usar NEXT_PUBLIC_*).
# Ver docs/notificaciones-email.md para el paso a paso.

# Clave de API de Resend (Resend → API Keys). Empieza con "re_".
RESEND_API_KEY=re_tu-api-key

# Remitente verificado en Resend. Debe usar un dominio verificado.
# Formato: "Nombre visible <casilla@tu-dominio.com>".
RESEND_FROM=Quintana Ruiz Asesores <recordatorios@tu-dominio.com>

# Secreto que protege el endpoint programado /api/notificaciones/cron.
# Vercel Cron lo envía automáticamente como "Authorization: Bearer <CRON_SECRET>".
# Generá un valor largo y aleatorio (p. ej. `openssl rand -hex 32`).
CRON_SECRET=un-secreto-largo-y-aleatorio
